# 从 Google AI Studio 复制免费 Key，粘到等号后面。不要加引号。
GEMINI_API_KEY=

# 0.0.0.0 表示局域网里的设备也能打开。改成 127.0.0.1 就只给本机。
QUICKBACK_HOST=0.0.0.0
QUICKBACK_PORT=8765

# 一般不用改。免费档可直接用这两个模型。
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_FEEDBACK_MODEL=gemini-3.6-flash
GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts

# 页面上可以在 Gemini 和千问之间切换。默认用 Gemini。
QUICKBACK_PROVIDER=gemini

# 千问 Key 从阿里云百炼复制。不要加引号。
DASHSCOPE_API_KEY=
QWEN_FEEDBACK_MODEL=qwen-flash
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
